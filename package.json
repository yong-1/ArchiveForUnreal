{
  "name": "nextflix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib scripts tests e2e playwright.config.ts --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "db:generate": "tsx scripts/db.ts generate",
    "db:deploy": "tsx scripts/db.ts migrate deploy",
    "db:local": "tsx scripts/local-db.ts",
    "dev:local": "tsx scripts/local-dev.ts",
    "worker": "tsx scripts/worker.ts",
    "postinstall": "prisma generate",
    "test:e2e": "playwright test",
    "maintenance": "tsx scripts/maintenance.ts"
  },
  "overrides": {
    "brace-expansion@^1.1.0": "1.1.21",
    "deepmerge-ts": "8.0.2"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "6.19.3",
    "archiver": "^7.0.1",
    "@noble/hashes": "2.4.0",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "axios": "^1.7.2",
    "bcrypt-ts": "^5.0.2",
    "next": "16.4.3",
    "next-auth": "4.24.15",
    "node-fetch": "^2.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^5.2.1",
    "react-toastify": "^10.0.5",
    "sharp": "^0.35.5",
    "swr": "^2.4.1",
    "zustand": "^5.0.11",
    "zod": "^4.3.6",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/archiver": "^6.0.3",
    "@electric-sql/pglite": "0.5.13",
    "@electric-sql/pglite-socket": "0.2.16",
    "@playwright/test": "^1.58.2",
    "eslint": "^8",
    "eslint-config-next": "15.5.12",
    "postcss": "^8",
    "prisma": "6.19.3",
    "tsx": "^4.21.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
