# 운영용 PostgreSQL. 비밀번호와 비밀 키를 저장소에 커밋하지 마세요.
DATABASE_URL=postgresql://archive_user:CHANGE_ME@localhost:5432/production_archive
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
BOOTSTRAP_TOKEN=
# Windows에서는 실제 승인된 NAS 공유(UNC) 또는 서비스 계정이 접근 가능한 경로
ARCHIVE_ROOT=
STAGING_ROOT=
PREVIEW_ROOT=
# JSON 배열. NAS 가져오기에서 관리자가 등록할 수 있는 원본 루트
SOURCE_ROOTS=[]
# 선택: 별도 새 작업 공간에 복원할 때만 지정
RESTORE_ROOT=
# 비워 두면 프로젝트에 설치된 바이너리 사용
FFMPEG_PATH=
FFPROBE_PATH=
# 비워 두면 설치된 libsvtav1 또는 libaom-av1을 자동 선택
AV1_ENCODER=
AV1_CRF=32
AV1_MAX_HEIGHT=1080
STORAGE_RESERVE_BYTES=268435456
# 정리·무결성 점검 주기(분)와 1회 해시 점검 바이트 상한
MAINTENANCE_INTERVAL_MINUTES=60
MAINTENANCE_HASH_BYTES=2147483648
